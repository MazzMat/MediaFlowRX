    "Slug" : {

    },
    "Slug and key identify the stream. Allowed: letters, numbers, dot, hyphen and underscore. One encoder at a time." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slug e key identificano il flusso. Ammessi: lettere, numeri, punto, trattino e underscore. Un solo encoder alla volta."
          }
        }
      }
    },
    "Slug and key may only contain letters, numbers, dot, hyphen and underscore" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slug e key usano solo lettere, numeri, punto, trattino e underscore"
          }
        }
      }
    },
    "Slug, key and port are required" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slug, key e porta sono obbligatori"
